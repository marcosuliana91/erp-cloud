{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "APISIX - Detalhe da API & Request. Decomposicao de latencia (gateway vs upstream), edge vs backend, consumers e logs de request/response. Selecione a API em $service.",
  "editable": true,
  "graphTooltip": 2,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Voltar para Visao Geral",
      "type": "link",
      "url": "/d/apisix-overview"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": ["apisix", "deep-dive", "logs"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus-prd-bifrost", "value": "nLiZZi8Mz" },
        "includeAll": false,
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "loki-prd-bifrost", "value": "C3KQM1jMz" },
        "includeAll": false,
        "refresh": 1
      },
      {
        "name": "service",
        "label": "API (service)",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(apisix_http_status, service)",
        "query": { "qryType": 1, "query": "label_values(apisix_http_status, service)", "refId": "var" },
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "matched_host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(apisix_http_status, matched_host)",
        "query": { "qryType": 1, "query": "label_values(apisix_http_status, matched_host)", "refId": "var" },
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "consumer",
        "label": "Consumer",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(apisix_http_status{service=~\"$service\"}, consumer)",
        "query": { "qryType": 1, "query": "label_values(apisix_http_status{service=~\"$service\"}, consumer)", "refId": "var" },
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "method",
        "label": "Method (logs)",
        "type": "custom",
        "query": "GET,POST,PUT,DELETE,PATCH,HEAD,OPTIONS",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "valuesFormat": "csv"
      },
      {
        "name": "status_code",
        "label": "Status (logs)",
        "type": "custom",
        "query": "2.. : 2xx,3.. : 3xx,4.. : 4xx,5.. : 5xx",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "valuesFormat": "csv"
      },
      {
        "name": "path",
        "label": "Path (logs)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "title": "APISIX • Detalhe da API & Request",
  "uid": "apisix-deepdive",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "📌 Resumo da API",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "🚀 RPS",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\"}[5m]))", "legendFormat": "RPS", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "❌ Erro 5xx",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 0.001 }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"5..\"}[5m])) / sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\"}[5m]))", "legendFormat": "Erro 5xx", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "✅ Disponibilidade",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3, "min": 0.9, "max": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "orange", "value": 0.95 }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.999 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "1 - (sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"5..\"}[5m])) / sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "Disponib", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "⏱️ P95 request",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\",service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "P95", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "⏱️ P95 upstream",
      "description": "Tempo no backend.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"upstream\",service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "P95 up", "range": true, "refId": "A" } ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "🧩 Overhead APISIX P95",
      "description": "Latencia adicionada pelo proprio gateway (type=apisix). Costuma ser baixa - prova o valor da migracao.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"apisix\",service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "overhead", "range": true, "refId": "A" } ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "⚡ Latencia (gateway vs backend)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Decomposicao de latencia P95 — request / upstream / apisix",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "axisLabel": "ms" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "total (request)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }, { "id": "custom.lineWidth", "value": 3 } ] },
          { "matcher": { "id": "byName", "options": "backend (upstream)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "gateway (apisix)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      },
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\",service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "total (request)", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"upstream\",service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "backend (upstream)", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"apisix\",service=~\"$service\",consumer=~\"$consumer\"}[5m])))", "legendFormat": "gateway (apisix)", "range": true, "refId": "C" }
      ]
    },
    {
      "type": "heatmap",
      "id": 8,
      "title": "Distribuicao de latencia (request)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "scaleDistribution": { "type": "linear" } } }, "overrides": [] },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Oranges", "steps": 64, "reverse": false, "exponent": 0.5, "fill": "dark-orange", "scale": "exponential" },
        "yAxis": { "axisPlacement": "left", "unit": "ms", "reverse": false },
        "tooltip": { "mode": "single", "showColorScale": true, "yHistogram": false },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "filterValues": { "le": 1e-9 }
      },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (le) (increase(apisix_http_latency_bucket{type=\"request\",service=~\"$service\",consumer=~\"$consumer\"}[$__rate_interval]))", "format": "heatmap", "legendFormat": "{{le}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "🚦 Status & Edge vs Backend",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Status no tempo por classe",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "group": "A", "mode": "normal" }, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"2..\"}[5m]))", "legendFormat": "2xx", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"3..\"}[5m]))", "legendFormat": "3xx", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"4..\"}[5m]))", "legendFormat": "4xx", "range": true, "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"5..\"}[5m]))", "legendFormat": "5xx", "range": true, "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Rejeicoes no Edge (node=\"\") — auth / rate-limit",
      "description": "Requests barrados no gateway, que NAO chegaram ao backend (node vazio).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "group": "A", "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (code) (rate(apisix_http_status{service=~\"$service\",node=\"\",code=~\"4..|5..\"}[5m]))", "legendFormat": "{{code}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "🔥 Erros & Trafego",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "5xx por codigo",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (code) (rate(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\",code=~\"5..\"}[5m]))", "legendFormat": "{{code}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "piechart",
      "id": 12,
      "title": "Distribuicao de status (no periodo)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "2.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"], "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] }, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single", "sort": "none" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (code) (increase(apisix_http_status{service=~\"$service\",consumer=~\"$consumer\"}[$__range]))", "legendFormat": "{{code}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Bandwidth (ingress / egress)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "binBps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ingress" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "egress" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_bandwidth{type=\"ingress\",service=~\"$service\",consumer=~\"$consumer\"}[5m]))", "legendFormat": "ingress", "range": true, "refId": "A" },
