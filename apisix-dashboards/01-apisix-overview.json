{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "APISIX - Visao Geral (NOC). Bater o olho: saude do gateway + qual API esta com problema. Clique numa linha da Matriz para abrir o Deep Dive ja filtrado.",
  "editable": true,
  "graphTooltip": 2,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Deep Dive (Detalhe da API & Request)",
      "type": "link",
      "url": "/d/apisix-deepdive"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 42,
  "tags": ["apisix", "overview", "noc"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus-prd-bifrost", "value": "nLiZZi8Mz" },
        "includeAll": false,
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(apisix_node_info, job)",
        "query": { "qryType": 1, "query": "label_values(apisix_node_info, job)", "refId": "var" },
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "title": "APISIX • Visao Geral",
  "uid": "apisix-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "🩺 Saude do Gateway",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "🟢 Pods UP",
      "description": "Numero de instancias APISIX respondendo ao scrape. Some um pod = caiu do scrape.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(up{job=~\"$job\"})", "legendFormat": "Pods", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "🗄️ etcd",
      "description": "Control plane: 1 = alcancavel, 0 = inalcancavel.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "min(apisix_etcd_reachable)", "legendFormat": "etcd", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "🚀 RPS",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": 0 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status[5m]))", "legendFormat": "RPS", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "❌ Erro 5xx",
      "description": "Taxa de erro do servidor (so 5xx). 4xx NAO conta como erro.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2, "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 0.001 }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{code=~\"5..\"}[5m])) / sum(rate(apisix_http_status[5m]))", "legendFormat": "Erro 5xx", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "⏱️ P95 (request)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))", "legendFormat": "P95", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "⚠️ Metric Errors",
      "description": "apisix_nginx_metric_errors_total: se > 0, o shared dict de metricas encheu e voce esta PERDENDO metrica (cardinalidade). Tudo no dash passa a mentir.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 0.001 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_nginx_metric_errors_total[5m]))", "legendFormat": "errors/s", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "📈 Golden Signals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Trafego por classe de status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "group": "A", "mode": "normal" }, "showPoints": "never", "axisLabel": "req/s" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{code=~\"2..\"}[5m]))", "legendFormat": "2xx", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{code=~\"3..\"}[5m]))", "legendFormat": "3xx", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{code=~\"4..\"}[5m]))", "legendFormat": "4xx", "range": true, "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum(rate(apisix_http_status{code=~\"5..\"}[5m]))", "legendFormat": "5xx", "range": true, "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Latencia P50 / P95 / P99 (request)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "lineInterpolation": "smooth", "showPoints": "never", "axisLabel": "ms", "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": 0 }, { "color": "red", "value": 500 } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "P50" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "P95" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "P99" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))", "legendFormat": "P50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))", "legendFormat": "P95", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))", "legendFormat": "P99", "range": true, "refId": "C" }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "🎯 Matriz de Saude por API (clique para o Deep Dive)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "type": "table",
      "id": 9,
      "title": "Matriz de Saude por API (service)",
      "description": "Uma linha por service. Ordenada por Erro% desc - a API pior sobe ao topo. Clique na coluna API para abrir o Deep Dive filtrado.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "API" },
            "properties": [
              { "id": "custom.width", "value": 360 },
              { "id": "links", "value": [ { "title": "Abrir Deep Dive desta API", "url": "/d/apisix-deepdive?var-service=${__data.fields.API}&${__url_time_range}", "targetBlank": false } ] }
            ]
          },
          { "matcher": { "id": "byName", "options": "RPS" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "lcd" } }, { "id": "min", "value": 0 } ] },
          {
            "matcher": { "id": "byName", "options": "Erro%" },
            "properties": [
              { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 2 }, { "id": "min", "value": 0 }, { "id": "max", "value": 0.2 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 0.01 }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.1 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "P95 req" },
            "properties": [
              { "id": "unit", "value": "ms" }, { "id": "min", "value": 0 }, { "id": "max", "value": 2000 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "P95 upstream" },
            "properties": [
              { "id": "unit", "value": "ms" }, { "id": "min", "value": 0 }, { "id": "max", "value": 2000 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 } ] } }
            ]
          },
          { "matcher": { "id": "byName", "options": "Rejeicoes edge (4xx)" }, "properties": [ { "id": "unit", "value": "reqps" }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "text", "value": 0 }, { "color": "orange", "value": 1 } ] } } ] }
        ]
      },
      "options": { "cellHeight": "sm", "showHeader": true, "enablePagination": true, "sortBy": [ { "displayName": "Erro%", "desc": true } ] },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (service) (rate(apisix_http_status[5m]))", "format": "table", "instant": true, "range": false, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (service) (rate(apisix_http_status{code=~\"5..\"}[5m])) / sum by (service) (rate(apisix_http_status[5m]))", "format": "table", "instant": true, "range": false, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (service, le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m])))", "format": "table", "instant": true, "range": false, "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (service, le) (rate(apisix_http_latency_bucket{type=\"upstream\"}[5m])))", "format": "table", "instant": true, "range": false, "refId": "D" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "sum by (service) (rate(apisix_http_status{code=~\"401|403|429\"}[5m]))", "format": "table", "instant": true, "range": false, "refId": "E" }
      ],
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "service" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true },
            "renameByName": { "service": "API", "Value #A": "RPS", "Value #B": "Erro%", "Value #C": "P95 req", "Value #D": "P95 upstream", "Value #E": "Rejeicoes edge (4xx)" }
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "🔝 Top Offenders",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "type": "bargauge",
      "id": 10,
      "title": "Top APIs por Erro 5xx %",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2, "min": 0, "max": 0.2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "legend": { "showLegend": false } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "topk(10, sum by (service) (rate(apisix_http_status{code=~\"5..\"}[5m])) / sum by (service) (rate(apisix_http_status[5m])))", "legendFormat": "{{service}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "bargauge",
      "id": 11,
      "title": "Top APIs por P95 (request)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 } ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "legend": { "showLegend": false } },
      "pluginVersion": "12.4.2",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "editorMode": "code", "expr": "topk(10, histogram_quantile(0.95, sum by (service, le) (rate(apisix_http_latency_bucket{type=\"request\"}[5m]))))", "legendFormat": "{{service}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "bargauge",
      "id": 12,
      "title": "Top Consumers por 429 (pressao de rate-limit)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] }
        },
        "overrides": []
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "legend": { "showLegend": false } },
      "pluginVersion": "12.4.2",
      "targets": [
